# Public Firebase web configuration: Project settings > Your apps >
# Shehroz Portfolio Web > SDK setup and configuration.
# Copy to .env.local and fill every value; never put private credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=shehroz-portfolio-45a2b
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public visitor wall configuration. These are build-time browser values.
VITE_SUPABASE_URL=https://lctzkigzaudjiotopzye.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Explicit preview by default; live failures never become preview successes.
VITE_CONTACT_MODE=preview
VITE_CONTACT_BACKEND=supabase
VITE_VISITOR_SUBMISSIONS_ENABLED=false
# Existing Firebase private contact endpoint, independent of the visitor wall.
VITE_CONTACT_FUNCTIONS_URL=
